# Copia este archivo a .env y llena los valores. NUNCA lo subas a git.
# Usado tanto por `npm run local` (dev sin Docker) como por `docker compose up` (con .env.docker).

# --- Alibaba Model Studio (visión + redacción del informe) --------------
DASHSCOPE_API_KEY=sk-ws-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIBABA_BASE_URL=https://ws-xxxxxxxxxxxx.us-east-1.maas.aliyuncs.com/compatible-mode/v1
# MODELO_VISION=qwen3-vl-plus
# MODELO_INFORME=qwen-flash

# --- Postgres (solo lo usa docker-compose -- servidor-local.mjs no toca la base) ---
POSTGRES_USER=auriscan
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=auriscan
# La arma docker-compose sola a partir de las 3 de arriba; para conectarte a mano:
# DATABASE_URL=postgresql://auriscan:cambia-esto@localhost:5432/auriscan

# --- Clerk (login, solo Google habilitado en su dashboard) --------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Almacenamiento de fotos + PDFs --------------------------------------
# local (por defecto): guarda en el volumen Docker "archivos", sin necesitar bucket real
# -- para pruebas. oss: sube a Alibaba OSS de verdad -- para cuando ya haya cuenta.
STORAGE_DRIVER=local
# OSS_REGION=oss-us-east-1
# OSS_BUCKET=auriscan-archivos
# OSS_AK_ID=xxxxxxxxxxxxxxxxxxxx
# OSS_AK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Wompi (pago para desbloquear el PDF) --------------------------------
WOMPI_ENV=test
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxx
PRECIO_PDF_COP=15000

# --- App -------------------------------------------------------------
APP_ORIGIN=http://localhost
CONSENT_VERSION=v1
RESPALDO_HORA_UTC=7
# Correos con acceso a /admin (separados por coma) -- se valida contra el correo real de
# la cuenta de Google/Clerk, no algo que el usuario pueda cambiar desde el navegador.
ADMIN_EMAILS=correo1@gmail.com,correo2@gmail.com
